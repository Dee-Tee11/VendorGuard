PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# id do webhook criado em developer.paypal.com → a tua app → Webhooks (precisa de URL público)
PAYPAL_WEBHOOK_ID=
# sandbox por defeito; em produção https://api-m.paypal.com
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
DATABASE_URL=postgresql://postgres:dev@localhost:5432/postgres
# console.groq.com → API Keys. Sem chave a app não arranca.
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# app.tavily.com → API Keys. Opcional: sem chave, uma pergunta sem nota recebe só o link de ajuda do PayPal.
# Desliga "Allow Use of Query Data" na conta Tavily (as pesquisas não ficam guardadas).
TAVILY_API_KEY=
# modelo Groq com visão que lê as capturas de ecrã. É preview: pode ser retirado sem aviso
VISION_MODEL=qwen/qwen3.8-27b
# Demo ao vivo em /demo (só sandbox: a app não arranca com DEMO_MODE=true contra o PayPal live).
# A conta personal de sandbox dos EUA com que os testers pagam; a página mostra o email e a password.
DEMO_MODE=false
DEMO_BUYER_EMAIL=
DEMO_BUYER_PASSWORD=
# LangSmith: só com conversas de teste. Envia as conversas e as respostas para o LangSmith,
# por isso nunca ligar no Render nem com casos reais.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=vendorguard-dev
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com  # conta na região EU
